	partition Equipos = m
		mode: import
		source =
				let
				    // 1) Tabla SLANOVEDADES de la hoja BASE (un registro por equipo)
				    Origen = Excel.Workbook(File.Contents(RutaExcel), null, true),
				    Tabla = Origen{[Item = "SLANOVEDADES", Kind = "Table"]}[Data],

				    // 2) Columnas útiles con nombres legibles (la de batería se busca por nombre por la tilde)
				    ColBateria = List.First(List.Select(Table.ColumnNames(Tabla), each Text.StartsWith(Text.Upper(_), "BATER")), "BATERÍA"),
				    Origenes = {
				        {"ID", "ID"}, {"HANDSET_QUOTE_ID", "Handset quote ID"}, {"SERIAL_NUMBER", "Serial"},
				        {"PROYECTO", "Proyecto"}, {"MARCA", "Marca"}, {"MODELO", "Modelo"}, {"LOTE", "Lote"},
				        {"FECHA_CREACION", "Fecha creación"}, {"ETAPA_PROCESO", "Estado sistema"},
				        {"Grading MPX", "Grading MPX"}, {"Grading de Compra", "Grading compra"}, {"Grading de Venta", "Grading venta"},
				        {ColBateria, "Salud batería"},
				        {"FECHA PRE-RECEPCION", "Fecha pre-recepción"}, {"USR PRE-RECEPCION", "Usr pre-recepción"},
				        {"FECHA RECEPCIONADO", "Fecha recepción"}, {"USR RECEPCIONADO", "Usr recepción"},
				        {"FECHA GRADE COMPRA", "Fecha compra"}, {"USR GRADE COMPRA", "Usr compra"},
				        {"FECHA COSMETICO", "Fecha cosmética"}, {"USR COSMETICO", "Usr cosmética"},
				        {"FECHA FUNCIONAL", "Fecha funcional"}, {"USR FUNCIONAL", "Usr funcional"},
				        {"FECHA BATERIA", "Fecha batería"}, {"USR BATERIA", "Usr batería"},
				        {"FECHA DISPOSICION FINAL", "Fecha disposición final"}, {"USR DISPOSICION FINAL", "Usr disposición final"},
				        {"FECHA DESPACHO", "Fecha despacho"}, {"FECHA CIERRE", "Fecha cierre"},
				        {"FECHA ENVIO A REPARO", "Fecha envío reparo"}, {"FECHA_DEVOLUCION_DE_REPARO", "Fecha devolución reparo"}
				    },
				    Seleccion = Table.SelectColumns(Tabla, List.Transform(Origenes, each _{0}), MissingField.UseNull),
				    Renombrado = Table.RenameColumns(Seleccion, List.Select(Origenes, each _{0} <> _{1})),

				    // 3) La tabla de Excel trae miles de filas vacías al final: quedan solo las que tienen ID
				    ConDatos = Table.SelectRows(Renombrado, each [ID] <> null and Text.Trim(Text.From([ID])) <> ""),

				    // 4) Conversores: las fechas pueden venir como fecha, número de serie de Excel o texto
				    AFecha = (v) =>
				        if v = null then null
				        else if Value.Is(v, type datetime) then v
				        else if Value.Is(v, type date) then DateTime.From(v)
				        else if Value.Is(v, type number) then (if v > 1 then DateTime.From(v) else null)
				        else let t = Text.Trim(Text.From(v)) in
				            if t = "" then null else try DateTime.FromText(t, [Culture = "es-AR"]) otherwise null,
				    ATexto = (v) =>
				        if v = null then null
				        else let t = Text.Trim(if Value.Is(v, type number) then Number.ToText(v, "0") else Text.From(v)) in
				            if t = "" then null else t,
				    ColsFecha = {"Fecha creación", "Fecha pre-recepción", "Fecha recepción", "Fecha compra", "Fecha cosmética",
				        "Fecha funcional", "Fecha batería", "Fecha disposición final", "Fecha despacho", "Fecha cierre",
				        "Fecha envío reparo", "Fecha devolución reparo"},
				    ColsUsr = {"Usr pre-recepción", "Usr recepción", "Usr compra", "Usr cosmética", "Usr funcional",
				        "Usr batería", "Usr disposición final"},
				    ColsTexto = {"Handset quote ID", "Serial", "Proyecto", "Marca", "Modelo", "Lote", "Estado sistema",
				        "Grading MPX", "Grading compra", "Grading venta", "Salud batería"},
				    Tipos = Table.TransformColumns(ConDatos,
				        {{"ID", each Int64.From(_), Int64.Type}}
				        & List.Transform(ColsFecha, (c) => {c, AFecha, type nullable datetime})
				        & List.Transform(ColsTexto, (c) => {c, ATexto, type nullable text})
				        & List.Transform(ColsUsr, (c) => {c, each let t = ATexto(_) in if t = null then "(sin usuario)" else Text.Upper(t), type text})),

				    // 5) Normalización de textos (marcas y modelos vienen con mayúsculas mezcladas)
				    Normal = Table.TransformColumns(Tipos, {
				        {"Marca", each if _ = null then "SIN MARCA" else Text.Upper(_), type text},
				        {"Modelo", each if _ = null then "SIN MODELO" else Text.Upper(_), type text},
				        {"Proyecto", each if _ = null then "Sin proyecto" else _, type text},
				        {"Lote", each if _ = null then "Sin lote" else _, type text},
				        {"Estado sistema", each if _ = null then "Sin dato" else _, type text},
				        {"Grading MPX", each if _ = null then "Sin dato" else _, type text},
				        {"Grading compra", each if _ = null then "Sin dato" else _, type text},
				        {"Grading venta", each if _ = null then "Sin dato" else Text.Upper(_), type text},
				        {"Salud batería", each if _ = null then "Sin dato" else _, type text}}),

				    // 6) Destino de la disposición final (igual que el Excel: A/B/C = Packing, D/E/SLV = Scrap)
				    Destino = Table.AddColumn(Normal, "Destino", each
				        if List.Contains({"A", "B", "C"}, [Grading venta]) then "ABC"
				        else if List.Contains({"D", "E", "SLV"}, [Grading venta]) then "Scrap"
				        else "Sin grading", type text),

				    // 7) Estado actual del equipo en el flujo
				    Ahora = DateTime.LocalNow(),
				    Estado = Table.AddColumn(Destino, "Estado actual", each
				        if [Fecha cierre] <> null or [Fecha despacho] <> null then "Cerrado"
				        else if [Fecha disposición final] <> null then "Disposición final"
				        else if Text.Contains(Text.Upper([Estado sistema]), "CANCEL") then "Cancelado"
				        else if [Fecha recepción] = null then "Pendiente de recepción"
				        else if [Fecha envío reparo] <> null
				            and ([Fecha devolución reparo] = null or [Fecha devolución reparo] < [Fecha envío reparo]) then "En reparo"
				        else "En planta", type text),
				    OrdenEstado = Table.AddColumn(Estado, "Orden estado", each
				        List.PositionOf({"Pendiente de recepción", "En planta", "En reparo", "Disposición final", "Cerrado", "Cancelado"}, [Estado actual]) + 1, Int64.Type),

				    // 8) Última etapa registrada (la de fecha más reciente)
				    UltimaEtapa = Table.AddColumn(OrdenEstado, "Última etapa", each
				        let
				            Pasos = List.Select({
				                {"Recepción", [Fecha recepción]}, {"Compra", [Fecha compra]}, {"Cosmética", [Fecha cosmética]},
				                {"Funcional", [Fecha funcional]}, {"Batería", [Fecha batería]},
				                {"Vuelta de reparo", [Fecha devolución reparo]}, {"Disposición final", [Fecha disposición final]}},
				                each _{1} <> null),
				            Ultimo = if List.IsEmpty(Pasos) then null else List.Last(List.Sort(Pasos, each _{1}))
				        in
				            if Ultimo = null then "Sin movimientos" else Ultimo{0}, type text),
				    OrdenUltima = Table.AddColumn(UltimaEtapa, "Orden última etapa", each
				        List.PositionOf({"Sin movimientos", "Recepción", "Compra", "Cosmética", "Funcional", "Batería", "Vuelta de reparo", "Disposición final"}, [Última etapa]) + 1, Int64.Type),

				    // 9) Tiempos: lead time Recepción -> Disposición final y antigüedad de lo que sigue en planta
				    Lead = Table.AddColumn(OrdenUltima, "Lead time (días)", each
				        if [Fecha recepción] <> null and [Fecha disposición final] <> null
				            and [Fecha disposición final] >= [Fecha recepción]
				        then Number.Round(Duration.TotalDays([Fecha disposición final] - [Fecha recepción]), 1) else null,
				        type nullable number),
				    DiasPlanta = Table.AddColumn(Lead, "Días en planta", each
				        if List.Contains({"En planta", "En reparo"}, [Estado actual]) and [Fecha recepción] <> null
				        then Number.Round(Duration.TotalDays(Ahora - [Fecha recepción]), 1) else null, type nullable number),
				    Rango = Table.AddColumn(DiasPlanta, "Rango antigüedad", each
				        let d = [Días en planta] in
				            if d = null then null
				            else if d < 3 then "0–2 días" else if d < 8 then "3–7 días" else if d < 16 then "8–15 días"
				            else if d < 31 then "16–30 días" else if d < 91 then "31–90 días" else "Más de 90 días",
				        type nullable text),
				    OrdenRango = Table.AddColumn(Rango, "Orden rango", each
				        List.PositionOf({"0–2 días", "3–7 días", "8–15 días", "16–30 días", "31–90 días", "Más de 90 días"}, [Rango antigüedad]) + 1, Int64.Type),
				    OrdenBateria = Table.AddColumn(OrdenRango, "Orden salud batería", each
				        let p = List.PositionOf({"Superior a 95%", "Entre 91% y 95%", "Entre 90% y 94,9%", "Entre 85% y 89,9%", "Entre 81% y 90%", "Inferior a 85%", "Inferior a 80%", "Ok", "N/A", "Sin dato"}, [Salud batería]) in if p < 0 then 9 else p + 1, Int64.Type)
				in
				    OrdenBateria

	annotation PBI_ResultType = Table

