	column 'Orden día' = - INT ( Calendario[Fecha] )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c78ca33d-5fff-5604-bc0c-e1608f7f1df1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Día' =
			VAR _ult = MAX ( Eventos[Fecha] )
			RETURN
			    IF ( Calendario[Fecha] = _ult, "Último día", FORMAT ( Calendario[Fecha], "dd/mm/yyyy (ddd)" ) )
		dataType: string
		lineageTag: 3f51da4f-d780-514a-b5d0-50bca4e7cb4b
		summarizeBy: none
		sortByColumn: 'Orden día'

		annotation SummarizationSetBy = Automatic

	partition Calendario = m
		mode: import
		source =
				let
				    Inicio = #date(2024, 1, 1),
				    Hoy = Date.From(DateTime.LocalNow()),
				    Fechas = List.Dates(Inicio, Duration.Days(Hoy - Inicio) + 1, #duration(1, 0, 0, 0)),
				    Meses = {"ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sep", "oct", "nov", "dic"},
				    Dias = {"lun", "mar", "mié", "jue", "vie", "sáb", "dom"},
				    Tabla = Table.FromList(Fechas, Splitter.SplitByNothing(), type table [Fecha = date]),
				    Anio = Table.AddColumn(Tabla, "Año", each Date.Year([Fecha]), Int64.Type),
				    MesNum = Table.AddColumn(Anio, "Mes num", each Date.Month([Fecha]), Int64.Type),
				    Mes = Table.AddColumn(MesNum, "Mes", each Meses{[Mes num] - 1}, type text),
				    AnioMes = Table.AddColumn(Mes, "Año mes", each [Año] * 100 + [Mes num], Int64.Type),
				    MesAnio = Table.AddColumn(AnioMes, "Mes año", each Meses{[Mes num] - 1} & " " & Text.From([Año]), type text),
				    InicioSemana = Table.AddColumn(MesAnio, "Inicio semana", each Date.StartOfWeek([Fecha], Day.Monday), type date),
				    Semana = Table.AddColumn(InicioSemana, "Semana", each "Sem " & Date.ToText([Inicio semana], [Format = "dd/MM/yy"]), type text),
				    DiaNum = Table.AddColumn(Semana, "Día semana num", each Date.DayOfWeek([Fecha], Day.Monday) + 1, Int64.Type),
				    Dia = Table.AddColumn(DiaNum, "Día semana", each Dias{[Día semana num] - 1}, type text)
				in
				    Dia

	annotation PBI_ResultType = Table

