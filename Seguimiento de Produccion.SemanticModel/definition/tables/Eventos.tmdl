	partition Eventos = calculated
		mode: import
		source =
				// Una fila por equipo y etapa productiva realizada (equivale a los COUNTIFS de la hoja PRODUCCION)
				VAR _Pasos =
				    UNION (
				        SELECTCOLUMNS (
				            FILTER ( Equipos, NOT ISBLANK ( Equipos[Fecha recepción] ) ),
				            "ID", Equipos[ID], "Etapa", "Recepción",
				            "FechaHora", Equipos[Fecha recepción], "Usuario", Equipos[Usr recepción]
				        ),
				        SELECTCOLUMNS (
				            FILTER ( Equipos, NOT ISBLANK ( Equipos[Fecha compra] ) ),
				            "ID", Equipos[ID], "Etapa", "Compra",
				            "FechaHora", Equipos[Fecha compra], "Usuario", Equipos[Usr compra]
				        ),
				        SELECTCOLUMNS (
				            FILTER ( Equipos, NOT ISBLANK ( Equipos[Fecha cosmética] ) ),
				            "ID", Equipos[ID], "Etapa", "Cosmética",
				            "FechaHora", Equipos[Fecha cosmética], "Usuario", Equipos[Usr cosmética]
				        ),
				        SELECTCOLUMNS (
				            FILTER ( Equipos, NOT ISBLANK ( Equipos[Fecha funcional] ) ),
				            "ID", Equipos[ID], "Etapa", "Funcional",
				            "FechaHora", Equipos[Fecha funcional], "Usuario", Equipos[Usr funcional]
				        ),
				        SELECTCOLUMNS (
				            FILTER ( Equipos, NOT ISBLANK ( Equipos[Fecha batería] ) ),
				            "ID", Equipos[ID], "Etapa", "Batería",
				            "FechaHora", Equipos[Fecha batería], "Usuario", Equipos[Usr batería]
				        ),
				        SELECTCOLUMNS (
				            FILTER ( Equipos, NOT ISBLANK ( Equipos[Fecha disposición final] ) ),
				            "ID", Equipos[ID],
				            "Etapa", SWITCH ( Equipos[Destino], "ABC", "Disp. final ABC", "Scrap", "Disp. final Scrap", "Disp. final s/grading" ),
				            "FechaHora", Equipos[Fecha disposición final], "Usuario", Equipos[Usr disposición final]
				        )
				    )
				RETURN
				    SELECTCOLUMNS (
				        _Pasos,
				        "ID", [ID],
				        "Etapa", [Etapa],
				        "FechaHora", [FechaHora],
				        "Fecha", DATE ( YEAR ( [FechaHora] ), MONTH ( [FechaHora] ), DAY ( [FechaHora] ) ),
				        "Hora", HOUR ( [FechaHora] ),
				        "Usuario", [Usuario]
				    )

	annotation PBI_Id = ef0eea4eb9e4ccb95833

